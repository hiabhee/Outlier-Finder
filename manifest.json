{
  "manifest_version": 3,
  "name": "Outlier Finder",
  "short_name": "Outlier",
  "description": "Find posts and videos outperforming their creators on YouTube, X and Instagram.",
  "version": "1.3.0",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "action": {
    "default_title": "Outlier Finder",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "core/settings.js",
        "core/dataValidator.js",
        "core/outlierCalculator.js",
        "core/classification.js",
        "content/videoExtractor.js",
        "content/badgeManager.js",
        "content/observer.js",
        "content/content.js"
      ],
      "css": [
        "content/styles.css"
      ]
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "core/settings.js",
        "core/dataValidator.js",
        "core/outlierCalculator.js",
        "core/classification.js",
        "core/social.js",
        "core/instagram.js",
        "content/socialExtractor.js",
        "content/badgeManager.js",
        "content/observer.js",
        "content/socialContent.js"
      ],
      "css": [
        "content/styles.css"
      ]
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "content/xDataBridge.js"
      ]
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content/xTimelineReader.js"
      ]
    }
  ],
  "author": "hiabhee",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  }
}
